# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=omuz_db
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── Redis & Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
