{
  "expo": {
    "name": "Omuz",
    "slug": "omuz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C5CE7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.omuz.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C5CE7"
      },
      "package": "uz.omuz.app"
    },
    "extra": {
      "API_BASE_URL": "http://192.168.100.78:8001"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
